# ---------------------------------------------------------------------------
# Copie ce fichier en .env et remplace les valeurs. Le .env n'est jamais commité.
# ---------------------------------------------------------------------------

# --- Base de données ---
POSTGRES_DB=anisdev
POSTGRES_USER=anisdev
POSTGRES_PASSWORD=change-moi-en-local
POSTGRES_HOST=db
POSTGRES_PORT=5432

# --- Django ---
DJANGO_SETTINGS_MODULE=config.settings.dev
# Génère une clé : python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=cle-factice-de-developpement-a-remplacer
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,api
# Origines autorisées à appeler Django. Jamais "*", même en développement.
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:3000
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:3000
# Chemin de l'admin Django en production. Jamais "admin".
DJANGO_ADMIN_PATH=change-moi-en-chemin-imprevisible
# URL publique du site (Next), utilisée par Django pour construire les liens des emails.
SITE_URL=http://localhost:3000

# --- Next.js ---
# URL de Django, utilisée UNIQUEMENT côté serveur Next (Route Handlers).
# Ne jamais préfixer par NEXT_PUBLIC_ : le navigateur ne doit pas connaître Django.
API_INTERNAL_URL=http://api:8000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Bunny Stream (étape 4, valeurs factices ici) ---
BUNNY_LIBRARY_ID=
BUNNY_API_KEY=
BUNNY_TOKEN_AUTH_KEY=
BUNNY_CDN_HOSTNAME=

# --- Stockage des preuves de paiement (étape 3) ---
PAYMENT_PROOF_BUCKET=
PAYMENT_PROOF_ACCESS_KEY=
PAYMENT_PROOF_SECRET_KEY=
PAYMENT_PROOF_ENCRYPTION_KEY=

# --- Email (étape 9) ---
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=contact@anis.dev
